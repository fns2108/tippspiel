# Postgres. Required — this app has no local database and will not start without it.
# On Neon: use the POOLED connection string (host contains "-pooler").
DATABASE_URL=

# Comma-separated usernames who are admins. When this is set it is the COMPLETE
# list — nobody else is an admin, and admin cannot be granted from inside the
# app. Set it to your own name and leave it that way.
# Leave it empty only on a fresh install, where the first account to register
# becomes the admin so you can get in at all.
ADMIN_USERNAMES=

# Season the app defaults to. Leave empty to derive from the current date
# (the NFL season year rolls over in March).
NFL_SEASON=

# Shared secret for /api/cron/*. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Web push (optional; reminders degrade to the in-app banner without it).
# Reminders go through ntfy (https://ntfy.sh). Only needed for a self-hosted
# server; the public one is the default.
NTFY_SERVER=
# Used to make reminder notifications link back to the site.
APP_URL=
